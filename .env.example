FLASK_DEBUG=0
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=5000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cabcompare
MYSQL_USER=cabcompare_app
MYSQL_PASSWORD=replace_with_a_local_password

# Add only after securing an approved mapping provider account.
MAPS_PROVIDER=
MAPS_API_KEY=
# Optional: your Uber developer client id, added to Uber ride links.
UBER_CLIENT_ID=

# Optional: backend-only credentials for authorized live fare estimates.
UBER_SERVER_TOKEN=
UBER_API_BASE_URL=https://api.uber.com
# Uber terms require written permission for competitor comparisons.
UBER_COMPARISON_APPROVED=false
OLA_APP_TOKEN=
OLA_API_BASE_URL=https://devapi.olacabs.com

# Optional: Rapido prefill link once you have a verified one, e.g.
# RAPIDO_LINK_TEMPLATE=https://example/?plat={pickup_lat}&plng={pickup_lng}&dlat={drop_lat}&dlng={drop_lng}
RAPIDO_LINK_TEMPLATE=
