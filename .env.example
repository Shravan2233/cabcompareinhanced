FLASK_DEBUG=0
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=5000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cabcompare
MYSQL_USER=cabcompare_app
MYSQL_PASSWORD=replace_with_a_local_password

# Optional: add only after securing an approved Google Maps account (otherwise OpenStreetMap/OSRM is used).
MAPS_PROVIDER=
MAPS_API_KEY=

# Optional backend rate limiting & short TTL quote cache controls.
RATE_LIMIT_COMPARE_PER_MIN=30
RATE_LIMIT_PLACES_PER_MIN=90
QUOTE_CACHE_TTL_SECONDS=45

# Optional: Uber deep-link client ID and backend-only authorized quote credentials.
# Uber API Terms of Use require written approval for competitive price comparisons.
UBER_CLIENT_ID=
UBER_OAUTH_TOKEN=
UBER_SERVER_TOKEN=
UBER_API_BASE_URL=https://api.uber.com
UBER_COMPARISON_APPROVED=false

# Optional: invite-only Ola partner/session credentials (affiliates@olacabs.com).
OLA_APP_TOKEN=
OLA_BEARER_TOKEN=
OLA_AFFILIATE_UTM_SOURCE=
OLA_API_BASE_URL=https://devapi.olacabs.com

# Optional: authorized Rapido corporate/gateway quote URL & credentials.
RAPIDO_API_URL=
RAPIDO_AUTH_TOKEN=
RAPIDO_DEVICE_ID=
# Optional: Rapido prefill link once you have a verified partner template, e.g.
# RAPIDO_LINK_TEMPLATE=https://example/?plat={pickup_lat}&plng={pickup_lng}&dlat={drop_lat}&dlng={drop_lng}
RAPIDO_LINK_TEMPLATE=

# Optional: registered ONDC Buyer App (BAP) gateway URL & token for Namma Yatri live discovery.
NAMMA_YATRI_BAP_SEARCH_URL=
NAMMA_YATRI_AUTH_TOKEN=
